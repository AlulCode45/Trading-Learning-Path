# Environment Configuration for TraderLearning-Path

# Database Dialect: 'sqlite' (local default) or 'postgres'
DB_DIALECT=sqlite

# PostgreSQL Settings (When DB_DIALECT=postgres or running via Docker Compose)
POSTGRES_USER=tlp_user
POSTGRES_PASSWORD=tlp_secret_password
POSTGRES_DB=tlp_trading_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://tlp_user:tlp_secret_password@localhost:5432/tlp_trading_db

# Server Ports
PORT=3001
VITE_PORT=3000
